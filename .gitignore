# ===========================
# Maven 构建产物
# ===========================
**/target/
!**/src/main/**/target/
!**/src/test/**/target/
*.jar
*.war
*.ear
*.class

# Maven Wrapper（保留）
!.mvn/wrapper/maven-wrapper.jar

# ===========================
# 前端依赖与构建产物
# ===========================
**/node_modules/
**/dist/
# 保留 mall 静态 html（不是构建产物，是源码）
!mall/docs/dev-ops/nginx/html/

# ===========================
# Python 虚拟环境（不可跨平台迁移）
# ===========================
**/.venv/
**/venv/
**/__pycache__/

# ===========================
# Ollama 模型文件（1.3GB，Linux 上 ollama pull 重新下载）
# ===========================
**/ollama_data/

# ===========================
# IDE 配置
# ===========================
.idea/
**/.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.swo

# ===========================
# 运行时数据与日志
# ===========================
**/data/
**/logs/
*.log
*.log.*

# ===========================
# Claude Code 工具文件（本地专用）
# ===========================
.claude/
.agents/
skills-lock.json

# ===========================
# 操作系统生成文件
# ===========================
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ===========================
# 临时文件
# ===========================
*.tmp
*.bak
*.orig
*~

# ===========================
# 环境变量文件
# ===========================
.env
.env.local
.env.*.local
