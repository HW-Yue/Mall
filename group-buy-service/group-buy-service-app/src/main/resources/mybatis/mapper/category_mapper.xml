<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yue.groupbuy.infrastructure.dao.ICategoryDao">

    <resultMap id="dataMap" type="com.yue.groupbuy.infrastructure.dao.po.Category">
        <id column="id" property="id"/>
        <result column="code" property="code"/>
    </resultMap>

    <select id="queryById" parameterType="java.lang.Integer" resultMap="dataMap">
        select id, code
        from category
        where id = #{id}
    </select>

</mapper>
