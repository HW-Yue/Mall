<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yue.groupbuy.infrastructure.dao.IScSkuActivityDao">

    <select id="queryActivityIdBySCGoodsId" resultType="java.lang.Long">
        select activity_id
        from sc_sku_activity
        where source = #{source} and channel = #{channel} and goods_id = #{goodsId}
        limit 1
    </select>

</mapper>
