<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.permissionsystem.mapper.LogMapper">
    <delete id="delete">
        delete from sys_log
        where id in
        <foreach item="item" index="index" collection="ids" open="(" separator="," close=")">
            #{item}
        </foreach>
    </delete>
    <select id="list" resultType="com.permissionsystem.dto.LogDTO">
        select L.* from sys_log as L
        <where>
            <if test="username != null and username != ''">
                AND L.username like concat('%',#{username},'%')
            </if>
            <if test="operationType != null and operationType != ''">
                AND L.operation_type like concat('%',#{operationType},'%')
            </if>
            <if test="startTime != null">
                AND L.create_date >= #{startTime}
            </if>
            <if test="endTime != null">
                AND L.create_date &lt;= #{endTime}
            </if>
        </where>
        ORDER BY L.create_date DESC
    </select>
</mapper>