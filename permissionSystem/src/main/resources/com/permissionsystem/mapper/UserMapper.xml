<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.permissionsystem.mapper.UserMapper">
    <delete id="delete">
        delete from user
        where id in
        <foreach item="item" index="index" collection="ids" open="(" separator="," close=")">
            #{item}
        </foreach>
    </delete>
    <select id="list" resultType="com.permissionsystem.dto.UserDTO">
        select u.* from user as u
        <where>
            <if test="name != null and name != ''">
                AND u.name like concat('%',#{name},'%')
            </if>
            <if test="username != null and username != ''">
                AND u.username like concat('%',#{username},'%')
            </if>
            <if test="email != null and email != ''">
                AND u.email like concat('%',#{email},'%')
            </if>
            <if test="createdStart != null">
                AND u.created_at >= #{createdStart}
            </if>
            <if test="createdEnd != null">
                AND u.created_at &lt;= #{createdEnd}
            </if>
        </where>
        ORDER BY u.created_at DESC
    </select>

</mapper>