<?xml version="1.0" encoding="UTF-8"?>
<!--
    秒杀服务日志配置
    引入 common-log-starter 的基础配置，自动支持 trace-id 全链路追踪
-->
<configuration scan="true" scanPeriod="10 seconds">

    <!--
        预占 Nacos 内部 appender 名称，防止 Nacos Client 在 logback 初始化期间
        注册同名 RollingFileAppender 导致 "Collisions detected" 报错。
        Nacos 检测到名称已被注册后会跳过，不再重复创建。
    -->
    <appender name="CONFIG_LOG_FILE" class="ch.qos.logback.core.helpers.NOPAppender"/>
    <appender name="NAMING_LOG_FILE" class="ch.qos.logback.core.helpers.NOPAppender"/>
    <appender name="REMOTE_LOG_FILE" class="ch.qos.logback.core.helpers.NOPAppender"/>

    <!-- 引入 common-log-starter 的基础配置（带 trace-id 支持） -->
    <include resource="com/yue/common/log/logback/base.xml"/>

    <!-- 开发环境：增加调试日志 -->
    <springProfile name="dev">
        <logger name="com.yue.seckill" level="DEBUG"/>
        <logger name="com.yue.common.log" level="DEBUG"/>
    </springProfile>

    <!-- 生产环境：只保留 INFO 及以上 -->
    <springProfile name="prod">
        <logger name="com.yue.seckill" level="INFO"/>
    </springProfile>

    <!-- Root Logger -->
    <root level="INFO">
        <!-- 控制台输出 -->
        <appender-ref ref="CONSOLE"/>
        <!-- 异步文件输出（INFO 级别） -->
        <appender-ref ref="ASYNC_FILE_INFO"/>
        <!-- 异步文件输出（ERROR 级别） -->
        <appender-ref ref="ASYNC_FILE_ERROR"/>
    </root>

</configuration>
